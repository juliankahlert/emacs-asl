Name:           emacs-asl
Version:        @VERSION@
Release:        1%{?dist}
Summary:        ACPI Source Language mode for Emacs
License:        MIT
BuildArch:      noarch
Requires:       emacs >= 26.1
Requires:       emacs-filesystem

Source0:        %{name}-%{version}.tar.gz

%description
Syntax highlighting for ACPI Source Language (ASL) files in Emacs.

%prep
%setup -q -n %{name}-%{version}

%build

%install
mkdir -p %{buildroot}%{_datadir}/emacs/site-lisp/asl-mode
mkdir -p %{buildroot}%{_datadir}/emacs/site-lisp/site-start.d
install -pm 0644 asl-mode.el %{buildroot}%{_datadir}/emacs/site-lisp/asl-mode/asl-mode.el
install -pm 0644 packaging/asl-mode-init.el %{buildroot}%{_datadir}/emacs/site-lisp/site-start.d/asl-mode-init.el

%files
%license LICENSE
%doc README.md
%{_datadir}/emacs/site-lisp/asl-mode/asl-mode.el
%{_datadir}/emacs/site-lisp/site-start.d/asl-mode-init.el

%changelog
* Wed Sep 23 2026 Julian Kahlert <90937526+juliankahlert@users.noreply.github.com> - @VERSION@-1
- Initial package
